# FeedSure 360 — Environment Configuration Example
# Copy to .env for local deployment

# Backend Port and Host
PORT=8000
HOST=127.0.0.1

# SQLite Database Location
FEEDSURE_DB_PATH=backend/.data/feedsure.sqlite3

# JWT Authentication Secret Key
FEEDSURE_JWT_SECRET=feedsure-360-sih-2026-secret-key-production-ready

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Mobile API URL (Use 10.0.2.2 for Android Emulator, localhost for iOS/web)
FEEDSURE_API_URL=http://localhost:8000/api
